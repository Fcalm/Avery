{
  "name": "offerget",
  "private": true,
  "version": "0.1.0",
  "description": "OfferGet 本地优先的 AI 求职与简历助手（灾后重建工作区）",
  "author": "OfferGet",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "main": "apps/desktop/dist/main.js",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "start": "node node_modules/electron/cli.js .",
    "build:packages": "npm run build --workspace @offerget/contracts && npm run build --workspace @offerget/agent-sdk && npm run build --workspace @offerget/agent-core && npm run build --workspace @offerget/agent-module-host && npm run build --workspace @offerget/agent-modules-defaults && npm run build --workspace @offerget/backend",
    "build:renderer": "node node_modules/vite/bin/vite.js build",
    "build": "npm run build:packages && npm run build:renderer",
    "test": "npm run test --workspaces --if-present",
    "smoke": "node scripts/smoke-packaged-app.mjs",
    "pack:dir": "npm run build && node node_modules/electron-builder/out/cli/cli.js --dir",
    "pack:win": "npm run build && node node_modules/electron-builder/out/cli/cli.js --win"
  },
  "dependencies": {
    "@offerget/agent-core": "0.1.0",
    "@offerget/agent-module-host": "0.1.0",
    "@offerget/agent-modules-defaults": "0.1.0",
    "@offerget/agent-sdk": "0.1.0",
    "@offerget/backend": "0.1.0",
    "@offerget/contracts": "0.1.0",
    "@offerget/desktop": "0.1.0",
    "@napi-rs/canvas": "0.1.80",
    "@tanstack/react-query": "^5.59.0",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "ajv": "^8.20.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "^0.45.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "7.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  },
  "build": {
    "appId": "com.offerget.app",
    "productName": "OfferGet",
    "icon": "build/icon.ico",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release-rebuild"
    },
    "files": [
      "dist/**",
      "apps/**",
      "packages/**",
      "electron/**",
      "migrations/**",
      "node_modules/@offerget/**",
      "package.json"
    ]
  }
}
