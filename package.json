{
  "name": "avery",
  "private": true,
  "version": "0.2.1",
  "description": "Avery 本地优先的 AI 求职与简历助手（灾后重建工作区）",
  "author": "Avery",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "main": "apps/desktop/dist/main.js",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "start": "node node_modules/electron/cli.js .",
    "build:packages": "npm run build --workspace @avery/agent-sdk && npm run build --workspace @avery/contracts && npm run build --workspace @avery/agent-core && npm run build --workspace @avery/agent-module-host && npm run build --workspace @avery/agent-modules-defaults && npm run build --workspace @avery/backend && npm run build --workspace @avery/desktop",
    "build:renderer": "node node_modules/vite/bin/vite.js build",
    "build": "npm run build:packages && npm run build:renderer",
    "test": "npm run test:vitest && npm run test --workspaces --if-present",
    "test:vitest": "node node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "smoke": "node scripts/smoke-packaged-app.mjs",
    "smoke:browser-extension": "node scripts/smoke-browser-extension.mjs",
    "smoke:browser-migration": "node scripts/smoke-browser-migration-pb03.mjs",
    "audit:system-baseline": "node scripts/audit-evaluation-system-baseline.mjs",
    "smoke:evaluation-ui": "node scripts/smoke-evaluation-ui.mjs",
    "build:markitdown-sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-markitdown-sidecar.ps1",
    "pack:dir": "npm run build && npm run build:markitdown-sidecar && node node_modules/electron-builder/out/cli/cli.js --dir --publish never",
    "pack:win": "npm run build && npm run build:markitdown-sidecar && node node_modules/electron-builder/out/cli/cli.js --win --publish never"
  },
  "dependencies": {
    "@avery/application-benchmark": "2.0.0",
    "@napi-rs/canvas": "0.1.80",
    "@avery/agent-core": "0.1.0",
    "@avery/agent-module-host": "0.1.0",
    "@avery/agent-modules-defaults": "0.1.0",
    "@avery/agent-sdk": "0.1.0",
    "@avery/backend": "0.1.0",
    "@avery/contracts": "0.1.0",
    "@avery/desktop": "0.1.0",
    "@tanstack/react-query": "^5.59.0",
    "ajv": "^8.20.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "^0.45.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "com.avery.app",
    "productName": "Avery",
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
    "icon": "build/icon.ico",
    "asar": true,
    "npmRebuild": false,
    "publish": [{ "provider": "github", "owner": "Fcalm", "repo": "Avery" }],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "directories": {
      "output": "release-rebuild"
    },
    "files": [
      "dist/**",
      "apps/**",
      "!apps/desktop/dist/browser-companion.js",
      "packages/**",
      "skills/**",
      "electron/**",
      "migrations/**",
      "node_modules/@avery/**",
      "!node_modules/@avery/desktop/dist/browser-companion.js",
      "!**/*.map",
      "!**/docs/**",
      "!**/doc/**",
      "!**/tests/**",
      "!**/test/**",
      "!**/examples/**",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "public/assets/avery-system-icon.ico",
        "to": "avery-system-icon.ico"
      },
      {
        "from": "build/markitdown",
        "to": "markitdown",
        "filter": ["markitdown.exe"]
      },
      {
        "from": "apps/browser-extension",
        "to": "browser-extension",
        "filter": ["**/*"]
      }
    ]
  }
}
