{
  "manifest_version": 3,
  "name": "Avery Browser",
  "version": "0.2.0",
  "description": "Lets Avery operate only the browser tab created for the current job-search task.",
  "permissions": [
    "alarms",
    "debugger",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "pair.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Avery Browser"
  }
}
